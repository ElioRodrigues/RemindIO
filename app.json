{
  "expo": {
    "name": "RemindIO",
    "slug": "remindio",
    "scheme": "remindio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3FA"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F3FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O RemindIO usa a câmera para fotografar a caixa ou a receita do remédio.",
          "photosPermission": "O RemindIO usa suas fotos para mostrar a caixa ou a receita do remédio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A98BCB"
        }
      ]
    ]
  }
}
